/*
  # Evitar que la URL se filtre via Referer cuando el usuario hace clic en links externos
  Referrer-Policy: no-referrer
  # Evitar clickjacking y embeds que puedan exponer la URL
  X-Frame-Options: DENY
  # Prevenir MIME sniffing
  X-Content-Type-Options: nosniff
  # Forzar HTTPS siempre
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Limitar APIs de browser que no se usan (camera=(self) permite al propio sitio usar la cámara)
  Permissions-Policy: geolocation=(), microphone=(), camera=(self), payment=()

/admin.html
  # Bloquear acceso directo — ya lo maneja _redirects pero doble protección
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

